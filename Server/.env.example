# Server only. Never put these values in a built app or commit .env.
DEEPL_API_KEY=
DEEPL_PLAN=free
# Generate a random token of at least 32 characters. Enter this token in the app.
# This pilot deployment supports one private user's token, not public enrollment.
CLIENT_TOKEN=
PORT=8787
RATE_PER_MINUTE=60
DAILY_REQUEST_LIMIT=1000
